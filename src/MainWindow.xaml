<Window x:Class="VramMeter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:VramMeter"
        Title="VRAM Meter" Width="1180" Height="860" MinWidth="820" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg}" UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">
  <Window.Resources>
    <!-- The legend's key: the stripes cut out of a coloured square. -->
    <Style x:Key="Key" TargetType="Rectangle">
      <Setter Property="Width" Value="22"/>
      <Setter Property="Height" Value="22"/>
      <Setter Property="Margin" Value="0,0,12,0"/>
      <Setter Property="OpacityMask" Value="{StaticResource KeyStripes}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid Margin="40,30,40,22">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <!-- One meter per GPU -->
      <ItemsControl ItemsSource="{Binding Meters}" Focusable="False">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <StackPanel Margin="0,0,0,36">
              <Grid>
                <TextBlock Text="ESTIMATED VRAM USAGE:" FontSize="25" VerticalAlignment="Bottom"/>
                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom">
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <!-- This GPU's display: showing now, or a button to switch to it -->
                    <TextBlock Text="● USING THIS GPU" FontSize="13" Foreground="{StaticResource Focus}" VerticalAlignment="Center" Margin="0,0,16,0"
                               Visibility="{Binding ShowingVisibility}" ToolTip="Your monitor is showing this GPU's display: apps opened now start on it."/>
                    <Button Style="{StaticResource HudButton}" Click="SwitchHere_Click" VerticalAlignment="Center" Margin="0,0,16,0" Padding="12,5"
                            Visibility="{Binding SwitchVisibility}" ToolTip="{Binding SwitchTip}">
                      <TextBlock Text="SWITCH HERE" FontSize="13" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    </Button>
                    <Path Data="{Binding Logo}" Fill="{Binding LogoBrush}" Height="{Binding LogoHeight}" Width="{Binding LogoWidth}" Stretch="Uniform"
                          VerticalAlignment="Center" Visibility="{Binding LogoVisibility}"/>
                  </StackPanel>
                  <TextBlock Text="{Binding Name}" FontSize="14" Foreground="{StaticResource Dim}" HorizontalAlignment="Right" Margin="0,6,0,0"/>
                </StackPanel>
              </Grid>

              <Grid Height="46" Margin="0,16,0,0">
                <Border BorderBrush="{StaticResource Line}" BorderThickness="3,0,3,3"/>
                <Grid Margin="10,0,10,8">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{Binding FocusWidth}"/>
                    <ColumnDefinition Width="{Binding OtherWidth}"/>
                    <ColumnDefinition Width="{Binding FreeWidth}"/>
                  </Grid.ColumnDefinitions>
                  <Rectangle Fill="{StaticResource FocusStripes}" RenderOptions.EdgeMode="Aliased"/>
                  <Rectangle Grid.Column="1" Fill="{StaticResource OtherStripes}" RenderOptions.EdgeMode="Aliased"/>
                </Grid>
              </Grid>

              <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="11*"/>
                  <ColumnDefinition Width="9*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                  <Rectangle Style="{StaticResource Key}" Fill="{StaticResource Focus}"/>
                  <TextBlock FontSize="24" TextTrimming="CharacterEllipsis" MaxWidth="520">
                    <Run Text="{Binding FocusTitle, Mode=OneWay}"/><Run Text=":   "/><Run Text="{Binding FocusValue, Mode=OneWay}" Foreground="{StaticResource Focus}"/>
                  </TextBlock>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                  <Rectangle Style="{StaticResource Key}" Fill="{StaticResource Line}"/>
                  <TextBlock FontSize="24">
                    <Run Text="OTHER APPS:   "/><Run Text="{Binding OtherValue, Mode=OneWay}" Foreground="{StaticResource Dim}"/>
                  </TextBlock>
                </StackPanel>
                <TextBlock Grid.Column="2" Text="{Binding TotalText}" FontSize="24"/>
              </Grid>

              <!-- The GPU's vitals, then each monitor plugged into it -->
              <ItemsControl ItemsSource="{Binding Tiles}" Margin="0,18,0,0" Focusable="False">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <StackPanel Margin="0,0,0,8" Width="{Binding Width}">
                      <TextBlock Text="{Binding Label}" FontSize="11" Foreground="{StaticResource Dim}"/>
                      <TextBlock Text="{Binding Value}" FontSize="19"/>
                      <Button Style="{StaticResource TextButton}" Click="TileNote_Click" HorizontalAlignment="Left" Visibility="{Binding NoteVisibility}"
                              IsHitTestVisible="{Binding Url, Converter={x:Static local:HasValue.Instance}}" ToolTip="{Binding Url}">
                        <TextBlock Text="{Binding Note}" FontSize="11" Foreground="{Binding NoteBrush}"/>
                      </Button>
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <ItemsControl ItemsSource="{Binding Monitors}" Margin="0,2,0,0" Focusable="False">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <TextBlock FontSize="13" Foreground="{StaticResource Dim}" Margin="0,2,0,0">
                      <Run Text="DISPLAY   " Foreground="{StaticResource Dim}" FontSize="11"/><Run Text="{Binding Mode=OneWay}" Foreground="{StaticResource Fg}"/>
                    </TextBlock>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <Grid Grid.Row="1" Margin="0,8,0,12">
        <StackPanel Margin="0,0,500,0">
          <TextBlock Text="APPS USING VRAM" FontSize="20"/>
          <TextBlock Text="CLICK AN APP TO MEASURE IT AGAINST THE REST.  GPU PICKS THE CARD IT RUNS ON FROM ITS NEXT START.  END CLOSES IT."
                     FontSize="12" Foreground="{StaticResource Dim}" Margin="0,5,0,0" TextWrapping="Wrap"/>
        </StackPanel>
        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center">
          <Button Style="{StaticResource HudButton}" Click="Sort_Click" IsEnabled="{Binding CanSort}" ToolTip="{Binding SortTip}"
                  ToolTipService.ShowOnDisabled="True" Padding="14,6" HorizontalAlignment="Right">
            <TextBlock Text="WHICH GPU RUNS WHAT" FontSize="13" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
          </Button>
          <TextBlock Text="{Binding AutoSortText}" FontSize="11" Foreground="{StaticResource Dim}" HorizontalAlignment="Right" Margin="0,5,0,0"/>
          <!-- Which display Windows starts on (the display switch itself is beside each GPU's logo) -->
          <Button Style="{StaticResource TextButton}" Click="SignIn_Click" ToolTip="{Binding SignInTip}" HorizontalAlignment="Right" Margin="0,2,0,0"
                  Visibility="{Binding DisplaysVisibility}">
            <TextBlock Text="{Binding SignInText}" FontSize="11" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
          </Button>
        </StackPanel>
      </Grid>

      <!-- Column heads; 8px right for the list's scroll bar -->
      <Grid Grid.Row="2" Margin="10,0,18,6">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="160"/>
          <ColumnDefinition Width="100"/>
          <ColumnDefinition Width="110"/>
          <ColumnDefinition Width="240"/>
          <ColumnDefinition Width="76"/>
        </Grid.ColumnDefinitions>
        <!-- Click a heading to sort by it, again to reverse -->
        <Grid.Resources>
          <Style x:Key="Head" TargetType="Button" BasedOn="{StaticResource TextButton}">
            <Setter Property="Foreground" Value="{StaticResource Dim}"/>
            <Setter Property="ToolTip" Value="Sort by this column; click again to reverse"/>
          </Style>
        </Grid.Resources>
        <Button Style="{StaticResource Head}" Click="SortBy_Click" Tag="App" HorizontalAlignment="Left">
          <TextBlock Text="{Binding HeadApp}" FontSize="12" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
        </Button>
        <Button Grid.Column="2" Style="{StaticResource Head}" Click="SortBy_Click" Tag="Vram" HorizontalAlignment="Right">
          <TextBlock Text="{Binding HeadVram}" FontSize="12" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
        </Button>
        <Button Grid.Column="3" Style="{StaticResource Head}" Click="SortBy_Click" Tag="Shared" HorizontalAlignment="Right">
          <TextBlock Text="{Binding HeadShared}" FontSize="12" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
        </Button>
        <Button Grid.Column="4" Style="{StaticResource Head}" Click="SortBy_Click" Tag="Gpu" HorizontalAlignment="Right">
          <TextBlock Text="{Binding HeadGpu}" FontSize="12" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
        </Button>
      </Grid>

      <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Visible" Focusable="False">
        <ItemsControl ItemsSource="{Binding Apps}" Focusable="False">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border x:Name="row" BorderBrush="{StaticResource Rule}" BorderThickness="0,1,0,0" Background="Transparent"
                      Padding="10,9" Cursor="Hand" MouseLeftButtonUp="Row_Click">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="240"/>
                    <ColumnDefinition Width="76"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,16,0">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsMouseOver, ElementName=row}" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource Bright}"/>
                          </DataTrigger>
                          <DataTrigger Binding="{Binding IsFocus}" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource Focus}"/>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                    <Run Text="{Binding Title, Mode=OneWay}" FontSize="16"/><Run Text="   "/><Run Text="{Binding Exe, Mode=OneWay}" FontFamily="{StaticResource Plain}" FontSize="11.5" Foreground="{StaticResource Dim}"/>
                  </TextBlock>
                  <Rectangle Grid.Column="1" Height="8" HorizontalAlignment="Left" Width="{Binding BarWidth}" Fill="{Binding BarFill}"
                             RenderOptions.EdgeMode="Aliased"/>
                  <TextBlock Grid.Column="2" Text="{Binding Vram}" FontSize="15" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="3" Text="{Binding SharedRam}" FontSize="15" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                  <Button Grid.Column="4" Style="{StaticResource TextButton}" HorizontalAlignment="Right" VerticalAlignment="Center"
                          Click="Gpu_Click" IsEnabled="{Binding CanMove}" ToolTip="{Binding MoveTip}" ToolTipService.ShowOnDisabled="True">
                    <StackPanel>
                      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock Text="{Binding Choice}" FontSize="13" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        <Path Data="M0,0 L4,4 L8,0" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5"
                              Margin="7,0,0,0" VerticalAlignment="Center"/>
                      </StackPanel>
                      <TextBlock Text="{Binding NowOn}" FontSize="11" Foreground="{Binding NowOnBrush}" HorizontalAlignment="Right" Margin="0,2,15,0"/>
                    </StackPanel>
                  </Button>
                  <Button Grid.Column="5" Style="{StaticResource HudButton}" Content="END" HorizontalAlignment="Right" VerticalAlignment="Center"
                          Click="End_Click" IsEnabled="{Binding CanEnd}" ToolTip="{Binding EndTip}" ToolTipService.ShowOnDisabled="True"/>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>

      <StackPanel Grid.Row="4" Margin="0,14,0,0">
        <TextBlock Text="{Binding Status}" Foreground="{Binding StatusBrush}" FontSize="14" TextWrapping="Wrap"
                   Margin="0,0,0,8" Visibility="{Binding StatusVisibility}"/>
        <TextBlock Text="{Binding Note}" FontFamily="{StaticResource Plain}" FontSize="12" Foreground="{StaticResource Dim}"
                   TextWrapping="Wrap" MaxWidth="860" HorizontalAlignment="Left" Visibility="{Binding NoteVisibility}"/>
      </StackPanel>
    </Grid>

    <!-- Film grain, as on the game's screen -->
    <Rectangle x:Name="Grain" IsHitTestVisible="False" Opacity="0.06"/>
  </Grid>
</Window>
