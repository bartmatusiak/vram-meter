<Application x:Class="VramMeter.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
  <Application.Resources>
    <Color x:Key="BgColor">#0B0C0B</Color>
    <SolidColorBrush x:Key="Bg" Color="{StaticResource BgColor}"/>
    <SolidColorBrush x:Key="Fg" Color="#E9EBE6"/>
    <SolidColorBrush x:Key="Bright" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Dim" Color="#8C8F88"/>
    <SolidColorBrush x:Key="Line" Color="#D9DCD5"/>
    <SolidColorBrush x:Key="Focus" Color="#8FBF4F"/>
    <SolidColorBrush x:Key="Warn" Color="#E0A43A"/>
    <SolidColorBrush x:Key="Rule" Color="#14FFFFFF"/>
    <SolidColorBrush x:Key="Edge" Color="#33FFFFFF"/>
    <SolidColorBrush x:Key="NvidiaGreen" Color="#76B900"/>
    <SolidColorBrush x:Key="AmdBrand" Color="#ED1C24"/>
    <SolidColorBrush x:Key="IntelBrand" Color="#00C7FD"/>

    <!-- Bahnschrift ships with Windows: the condensed HUD face of the game's own meter. -->
    <FontFamily x:Key="Hud">Bahnschrift SemiCondensed, Bahnschrift, Segoe UI</FontFamily>
    <FontFamily x:Key="Plain">Segoe UI</FontFamily>

    <!-- The meter's stripes: a 2px tick every 5px. -->
    <DrawingBrush x:Key="FocusStripes" TileMode="Tile" Stretch="None"
                  Viewport="0,0,5,10" ViewportUnits="Absolute" Viewbox="0,0,5,10" ViewboxUnits="Absolute">
      <DrawingBrush.Drawing>
        <DrawingGroup>
          <GeometryDrawing Brush="Transparent" Geometry="M0,0 H5 V10 H0 Z"/>
          <GeometryDrawing Brush="#8FBF4F" Geometry="M0,0 H2 V10 H0 Z"/>
        </DrawingGroup>
      </DrawingBrush.Drawing>
    </DrawingBrush>
    <DrawingBrush x:Key="OtherStripes" TileMode="Tile" Stretch="None"
                  Viewport="0,0,5,10" ViewportUnits="Absolute" Viewbox="0,0,5,10" ViewboxUnits="Absolute">
      <DrawingBrush.Drawing>
        <DrawingGroup>
          <GeometryDrawing Brush="Transparent" Geometry="M0,0 H5 V10 H0 Z"/>
          <GeometryDrawing Brush="#D9DCD5" Geometry="M0,0 H2 V10 H0 Z"/>
        </DrawingGroup>
      </DrawingBrush.Drawing>
    </DrawingBrush>
    <!-- The legend's key: three ticks. -->
    <DrawingBrush x:Key="KeyStripes" TileMode="Tile" Stretch="None"
                  Viewport="0,0,7,10" ViewportUnits="Absolute" Viewbox="0,0,7,10" ViewboxUnits="Absolute">
      <DrawingBrush.Drawing>
        <DrawingGroup>
          <GeometryDrawing Brush="Transparent" Geometry="M0,0 H7 V10 H0 Z"/>
          <GeometryDrawing Brush="White" Geometry="M0,0 H3 V10 H0 Z"/>
        </DrawingGroup>
      </DrawingBrush.Drawing>
    </DrawingBrush>

    <Style TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource Hud}"/>
      <Setter Property="Foreground" Value="{StaticResource Fg}"/>
    </Style>

    <!-- Outlined buttons that brighten on hover (no glow, no filled ground). -->
    <Style x:Key="HudButton" TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource Dim}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Edge}"/>
      <Setter Property="FontFamily" Value="{StaticResource Hud}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Padding" Value="10,3"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="Transparent" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{StaticResource Bright}"/>
                <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Bright}"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Fg}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.35"/>
                <Setter Property="Cursor" Value="Arrow"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- A bare text button (the GPU choice): brightens on hover. -->
    <Style x:Key="TextButton" TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource Fg}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <ContentPresenter Margin="0,2" TextElement.Foreground="{TemplateBinding Foreground}"/>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{StaticResource Bright}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.35"/>
                <Setter Property="Cursor" Value="Arrow"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- A square box with a green mark; the label brightens on hover. -->
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="{StaticResource Fg}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Grid Background="Transparent">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Border x:Name="box" Width="16" Height="16" BorderBrush="{StaticResource Dim}" BorderThickness="1.5" VerticalAlignment="Center">
                <Rectangle x:Name="mark" Width="8" Height="8" Fill="{StaticResource Focus}" Visibility="Hidden"/>
              </Border>
              <ContentPresenter Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="mark" Property="Visibility" Value="Visible"/>
                <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource Focus}"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{StaticResource Bright}"/>
                <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource Bright}"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource Fg}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="ToolTip">
      <Setter Property="Background" Value="#141614"/>
      <Setter Property="Foreground" Value="{StaticResource Fg}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Edge}"/>
      <Setter Property="FontFamily" Value="{StaticResource Plain}"/>
      <Setter Property="Padding" Value="8,5"/>
    </Style>

    <Style TargetType="ContextMenu">
      <Setter Property="OverridesDefaultStyle" Value="True"/>
      <Setter Property="HasDropShadow" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ContextMenu">
            <Border Background="#141614" BorderBrush="{StaticResource Edge}" BorderThickness="1" Padding="0,6">
              <StackPanel IsItemsHost="True"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="MenuItem">
      <Setter Property="OverridesDefaultStyle" Value="True"/>
      <Setter Property="Foreground" Value="{StaticResource Dim}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="MenuItem">
            <Grid Background="Transparent" Margin="14,7,18,7">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Rectangle x:Name="mark" Width="8" Height="8" Fill="{StaticResource Focus}" Visibility="Hidden" VerticalAlignment="Center" HorizontalAlignment="Left"/>
              <ContentPresenter Grid.Column="1" ContentSource="Header" TextElement.Foreground="{TemplateBinding Foreground}"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="mark" Property="Visibility" Value="Visible"/>
                <Setter Property="Foreground" Value="{StaticResource Fg}"/>
              </Trigger>
              <Trigger Property="IsHighlighted" Value="True">
                <Setter Property="Foreground" Value="{StaticResource Bright}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="8"/>
      <Setter Property="MinWidth" Value="8"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
              <Track.Thumb>
                <Thumb>
                  <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                      <Border Background="#40FFFFFF" Margin="2,0"/>
                    </ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              </Track.Thumb>
            </Track>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

